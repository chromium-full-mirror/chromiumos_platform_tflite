From eb3467b5bf59e9f4adfdd43745df06a6bc4a7ce5 Mon Sep 17 00:00:00 2001
From: Tommy Chiang <ototot@google.com>
Date: Tue, 8 Oct 2024 04:08:10 -0700
Subject: [PATCH] Use ArrayFloatNear to check values in
 PowOpModel.BroadcastFloatTest

PiperOrigin-RevId: 683560684

PATCH_NAME=dts-powopmodel-broadcastfloattest
---
 tensorflow/lite/kernels/pow_test.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tensorflow/lite/kernels/pow_test.cc b/tensorflow/lite/kernels/pow_test.cc
index 553159c5..0eb381f4 100644
--- a/tensorflow/lite/kernels/pow_test.cc
+++ b/tensorflow/lite/kernels/pow_test.cc
@@ -119,7 +119,8 @@ TEST(PowOpModel, BroadcastFloatTest) {
   model.PopulateTensor<float>(model.input2(), {4});
   ASSERT_EQ(model.Invoke(), kTfLiteOk);
   EXPECT_THAT(model.GetOutputShape(), ElementsAre(1, 2, 2, 1));
-  EXPECT_THAT(model.GetOutput(), ElementsAre(20736, 16, 2401, 4096));
+  EXPECT_THAT(model.GetOutput(),
+              ElementsAreArray(ArrayFloatNear({20736, 16, 2401, 4096})));
 }
 
 template <typename T>
