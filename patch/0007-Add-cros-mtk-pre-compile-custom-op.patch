From ceb7bc2db5d0f251b44876a97d990b55210e5252 Mon Sep 17 00:00:00 2001
From: Yi Chou <yich@google.com>
Date: Fri, 23 Aug 2024 13:13:34 +0800
Subject: [PATCH] Add cros-mtk-pre-compile custom op

---
 tensorflow/lite/tools/benchmark/benchmark_tflite_model.cc        | 1 +
 .../lite/tools/evaluation/stages/tflite_inference_stage.cc       | 1 +
 2 files changed, 2 insertions(+)

diff --git a/tensorflow/lite/tools/benchmark/benchmark_tflite_model.cc b/tensorflow/lite/tools/benchmark/benchmark_tflite_model.cc
index b3b14b09..ef98e959 100644
--- a/tensorflow/lite/tools/benchmark/benchmark_tflite_model.cc
+++ b/tensorflow/lite/tools/benchmark/benchmark_tflite_model.cc
@@ -74,6 +74,7 @@ RegisterSelectedOps(::tflite::MutableOpResolver* resolver) {
   static TfLiteRegistration reg = { nullptr, nullptr, nullptr, nullptr };
   resolver->AddCustom("Convolution2DTransposeBias",
                       &reg);
+  resolver->AddCustom("cros-mtk-pre-compile", &reg);
 }
 
 namespace tflite {
diff --git a/tensorflow/lite/tools/evaluation/stages/tflite_inference_stage.cc b/tensorflow/lite/tools/evaluation/stages/tflite_inference_stage.cc
index 72a10f29..1ed824b4 100644
--- a/tensorflow/lite/tools/evaluation/stages/tflite_inference_stage.cc
+++ b/tensorflow/lite/tools/evaluation/stages/tflite_inference_stage.cc
@@ -150,6 +150,7 @@ TfLiteStatus TfliteInferenceStage::Init(
   }
   TfLiteRegistration reg = { nullptr, nullptr, nullptr, nullptr };
   resolver_->AddCustom("Convolution2DTransposeBias", &reg);
+  resolver_->AddCustom("cros-mtk-pre-compile", &reg);
   RegisterSelectedOps(resolver_.get());
   InterpreterBuilder(*model_, *resolver_)(&interpreter_);
   if (!interpreter_) {
